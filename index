
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>LayerCraft Studio</title>
<style>
* {box-sizing:border-box}
body {
  margin:0;
  padding:20px;
  font-family:Arial,sans-serif;
  background:#142d28;
  color:white;
}
main {max-width:800px;margin:auto}
h1 {color:#b9e8c6}
section {
  background:#25483e;
  padding:20px;
  border-radius:15px;
  margin:18px 0;
}
input,textarea,select,button {
  display:block;
  width:100%;
  padding:13px;
  margin:12px 0;
  border-radius:8px;
  font-size:16px;
}
textarea {height:110px}
button {
  background:#b9e8c6;
  border:none;
  font-weight:bold;
  cursor:pointer;
}
img,canvas {max-width:100%;border-radius:8px}
small {color:#cbdcd2}
</style>
</head>
<body>
<main>
<h1>LayerCraft Studio</h1>
<p>Design layered wooden artwork for laser cutting.</p>

<section>
<h2>1. Describe your design</h2>
<textarea id="description"
placeholder="Describe your design...">A traditional Christmas Nativity scene</textarea>

<label>Number of layers</label>
<input id="layers" type="number" value="6" min="2" max="10">

<label>Frame shape</label>
<select id="frame">
<option>Arch</option>
<option>Circle</option>
<option>Heart</option>
<option>Rectangle</option>
</select>

<button onclick="generate()">Generate AI Image</button>
<p id="status"></p>
<img id="result" alt="Generated artwork">
</section>

<section>
<h2>2. Upload existing artwork</h2>
<input type="file" accept="image/*"
onchange="upload(event)">
<canvas id="preview"></canvas>
</section>

<section>
<h2>3. Create your laser layers</h2>
<label>Number of tonal layers</label>
<input id="count" type="number" value="6" min="2" max="8">
<button onclick="makeLayers()">Create Layer Previews</button>
<div id="layerResults"></div>
<small>
These are experimental tonal previews.
Inspect and refine all cutting paths before using
your laser.
</small>
</section>
</main>

<script>
let sourceImage=null;
const canvas=document.getElementById("preview");
const ctx=canvas.getContext("2d");

function loadImage(src) {
  const img=new Image();
  img.onload=()=>{
    sourceImage=img;
    const scale=Math.min(1,600/img.width);
    canvas.width=Math.round(img.width*scale);
    canvas.height=Math.round(img.height*scale);
    ctx.drawImage(img,0,0,canvas.width,canvas.height);
  };
  img.src=src;
}

function upload(event) {
  const file=event.target.files[0];
  if(!file)return;
  const reader=new FileReader();
  reader.onload=()=>loadImage(reader.result);
  reader.readAsDataURL(file);
}

async function generate() {
  const status=document.getElementById("status");
  status.textContent="Generating your artwork...";
  const description=document.getElementById("description").value;
  const layers=document.getElementById("layers").value;
  const frame=document.getElementById("frame").value;

  try {
    const response=await fetch("/.netlify/functions/generate",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({description,layers,frame})
    });

    if(!response.ok)throw new Error("Generation unavailable");

    const data=await response.json();
    if(!data.image)throw new Error("No image returned");

    document.getElementById("result").src=data.image;
    loadImage(data.image);
    status.textContent="Artwork generated.";
  } catch(error) {
    status.textContent=
      "AI generation requires the Netlify server function and API key.";
  }
}

function makeLayers() {
  if(!sourceImage){
    alert("Generate or upload an image first.");
    return;
  }

  const count=Math.max(2,Math.min(8,
    Number(document.getElementById("count").value)
  ));
  const original=ctx.getImageData(
    0,0,canvas.width,canvas.height
  );
  const container=document.getElementById("layerResults");
  container.innerHTML="";

  for(let layer=0;layer<count;layer++){
    const c=document.createElement("canvas");
    c.width=canvas.width;
    c.height=canvas.height;
    const context=c.getContext("2d");
    const output=context.createImageData(c.width,c.height);

    for(let i=0;i<original.data.length;i+=4){
      const grey=
        original.data[i]*0.299+
        original.data[i+1]*0.587+
        original.data[i+2]*0.114;

      const band=Math.min(count-1,
        Math.floor(grey*count/256)
      );

      const value=band===layer?0:255;
      output.data[i]=value;
      output.data[i+1]=value;
      output.data[i+2]=value;
      output.data[i+3]=255;
    }

    context.putImageData(output,0,0);
    const heading=document.createElement("h3");
    heading.textContent="Layer "+(layer+1);
    container.appendChild(heading);
    container.appendChild(c);
  }
}
</script>
</body>
</html>
